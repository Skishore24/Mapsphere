# ==============================================================================
# MapSphere Global Environment Configuration Template
# ==============================================================================

# --- Backend Server & Spring Profiles ---
PORT=8081
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL & PostGIS Database ---
DB_URL=jdbc:postgresql://localhost:5432/mapsphere
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_POOL_MAX=10
DB_POOL_MIN=2
HIBERNATE_DDL_AUTO=update

# --- Security & JWT ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# --- Seeding & Allowed Origins ---
SEED_ENABLED=true
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# --- External GIS Providers ---
GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=MapSphere-Platform/1.0 (production-mapsphere@local.dev)
ROUTING_URL=https://router.project-osrm.org

# --- Frontend Environment Variables (Vite) ---
VITE_API_URL=http://localhost:8081
VITE_WS_URL=http://localhost:8081/ws-mapsphere
